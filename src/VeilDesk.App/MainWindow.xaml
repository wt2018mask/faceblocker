                                               Text="• DRM/secure windows can appear black to capture; such content cannot be verified."/>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,6"
                                               Text="• Video export is MJPEG AVI, no audio; not H.264."/>
                                    <TextBlock Style="{StaticResource Muted}"
                                               Text="• Some secondary features (tray, cloud sync, Discord) are intentionally absent."/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="DIAGNOSTICS" Style="{StaticResource SectionTitle}"/>
                                <TextBox x:Name="DiagnosticsBox" IsReadOnly="True" AcceptsReturn="True"
                                         FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Height="190"
                                         VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Copy diagnostics" Style="{StaticResource GhostButton}"
                                            Click="CopyDiagnostics_Click"/>
                                    <Button Content="Run capture probe" Style="{StaticResource GhostButton}"
                                            Margin="8,0,0,0" Click="RunProbe_Click"/>
                                    <Button Content="Open docs" Style="{StaticResource GhostButton}"
                                            Margin="8,0,0,0" Click="OpenDocs_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="ProbeStatus" Style="{StaticResource Muted}" Margin="0,9,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
