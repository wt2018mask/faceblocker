<Window x:Class="VeilDesk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VeilDesk — Local Real-Time Censorship"
        Width="1320" Height="880" MinWidth="1060" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="Window_Closing"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="14,22,14,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="10,0,10,24">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32" CornerRadius="9"
                                Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
                            <Path Data="M 16 5 L 26 10 L 26 18 C 26 24 21 27 16 29 C 11 27 6 24 6 18 L 6 10 Z"
                                  Fill="White" Stretch="Uniform" Margin="8"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="VeilDesk" FontSize="18" FontWeight="SemiBold"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"/>
                            <TextBlock Text="local protection" FontSize="10.5"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <ListBox x:Name="NavList" Grid.Row="1" Style="{StaticResource NavList}"
                         ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="NavList_SelectionChanged" SelectedIndex="0">
                    <ListBoxItem Content="Dashboard"/>
                    <ListBoxItem Content="Detection"/>
                    <ListBoxItem Content="Censoring"/>
                    <ListBoxItem Content="Displays"/>
                    <ListBoxItem Content="Performance"/>
                    <ListBoxItem Content="Export"/>
                    <ListBoxItem Content="Packs"/>
                    <ListBoxItem Content="Sessions"/>
                    <ListBoxItem Content="Settings"/>
                    <ListBoxItem Content="About &amp; diagnostics"/>
                </ListBox>

                <StackPanel Grid.Row="2">
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse x:Name="SidebarStatusDot" Width="8" Height="8"
                                         Fill="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SidebarStatusText" Text="Idle" FontSize="12.5"
                                           FontWeight="SemiBold" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="SidebarStatusDetail" Text="Nothing is being captured."
                                       Style="{StaticResource Muted}" FontSize="11.5"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="v1.0.0 · offline build" FontSize="10.5"
                               Foreground="{StaticResource MutedBrush}" Margin="4,0,0,2"/>
                    <TextBlock Text="No account · no telemetry" FontSize="10.5"
                               Foreground="{StaticResource MutedBrush}" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="34,26,34,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="Dashboard" Style="{StaticResource H1}"/>
                    <TextBlock x:Name="PageSubtitle" Text="A private, real-time censor that never sends a frame anywhere."
                               Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="StatePill" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="20" Padding="12,7" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StateDot" Width="8" Height="8"
                                     Fill="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StateText" Text="Idle" FontSize="12" FontWeight="SemiBold"
                                       Margin="7,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="HeaderStartButton" Content="Start protection"
                            Style="{StaticResource PrimaryButton}" Padding="18,9"
                            Click="StartStop_Click"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="34,0,28,26">
                <Grid>

                    <!-- DASHBOARD -->
                    <StackPanel x:Name="PageDashboard">
                        <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="HeroEyebrow" Text="PROTECTION OFF" FontSize="11"
                                               FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock x:Name="HeroTitle" Text="Your screen is not being captured."
                                               FontSize="25" FontWeight="SemiBold" Margin="0,8,0,6"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"/>
                                    <TextBlock x:Name="HeroBody" Style="{StaticResource Muted}" MaxWidth="620"
                                               Text="Choose targets, then start local desktop protection. Alt+S starts, stops, or cancels initialization. Ctrl+Shift+F10 stops protection from other applications."/>
                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                        <Button x:Name="HeroStartButton" Content="Start protection"
                                                Style="{StaticResource PrimaryButton}" Padding="20,10"
                                                Click="StartStop_Click"/>
                                        <Button x:Name="FaceOnlyButton" Content="_Face only · black" Style="{StaticResource GhostButton}"
                                                Margin="10,0,0,0" Click="FaceOnly_Click"/>
                                        <Button Content="Open settings" Style="{StaticResource GhostButton}"
                                                Margin="10,0,0,0" Click="GoSettings_Click"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="12"
                                            Padding="14,12" Width="200">
                                        <StackPanel>
                                            <TextBlock Text="PIPELINE" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock Text="WGC → ONNX → overlay" FontSize="13"
                                                       FontWeight="SemiBold" Margin="0,5,0,4"/>
                                            <TextBlock Text="100% on this PC" FontSize="11"
                                                       Foreground="{StaticResource GoodBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <UniformGrid Columns="4" Margin="0,0,0,16">
                            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="CAPTURE" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock x:Name="DashCapture" Text="—" Style="{StaticResource StatValue}"/>
                                    <TextBlock x:Name="DashCaptureSub" Text="frames per second" Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="ANALYSIS P50" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock x:Name="DashLatency" Text="—" Style="{StaticResource StatValue}"/>
                                    <TextBlock x:Name="DashLatencySub" Text="full local inference" Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="ACTIVE TRACKS" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock x:Name="DashTracks" Text="0" Style="{StaticResource StatValue}"/>
                                    <TextBlock x:Name="DashTracksSub" Text="persistent subjects" Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="DETECTION EVENTS" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock x:Name="DashDetections" Text="0" Style="{StaticResource StatValue}"/>
                                    <TextBlock x:Name="DashDetectionsSub" Text="this session" Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="ACTIVE DISPLAYS" Style="{StaticResource SectionTitle}"/>
                                    <StackPanel x:Name="DashMonitorsPanel">
                                        <TextBlock Text="Protection is idle. Connected displays will appear here."
                                                   Style="{StaticResource Muted}"/>
                                    </StackPanel>
                                    <Border Style="{StaticResource Divider}"/>
                                    <TextBlock Text="GUARDRAILS" Style="{StaticResource SectionTitle}"/>
                                    <StackPanel>
                                        <TextBlock Text="• Overlay windows are excluded from capture (WDA_EXCLUDEFROMCAPTURE)."
                                                   Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                                        <TextBlock Text="• Fail-closed covers the display when inference stops being confident or recent."
                                                   Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                                        <TextBlock Text="• No screen, frame, detection or session leaves this machine."
                                                   Style="{StaticResource Muted}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="PIPELINE HEALTH" Style="{StaticResource SectionTitle}"/>
                                    <StackPanel x:Name="DashHealthPanel">
                                        <TextBlock Text="Start protection to see provider, overlay exclusion and frame freshness."
                                                   Style="{StaticResource Muted}"/>
                                    </StackPanel>
                                    <Border Style="{StaticResource Divider}"/>
                                    <TextBlock Text="A NOTE ON HONESTY" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Style="{StaticResource Muted}"
                                               Text="This build runs real models on real captured frames. It does not pretend that every detector is perfect: false positives and missed detections exist and are documented. Fail-closed is the safety net."/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- DETECTION -->
                    <StackPanel x:Name="PageDetection" Visibility="Collapsed">
                        <TextBlock Text="Targets can be changed while stopped. Face confidence is separate from anatomical confidence." Style="{StaticResource Muted}" Margin="0,0,0,12"/>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="TARGETS · FACE AND ANATOMICAL REGIONS" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Face uses dedicated local YuNet detection for all people. Other regions use NudeNet. Clear all, then select Face for face-only protection. Stop before changing targets."
                                           Style="{StaticResource Muted}" Margin="0,0,0,14"/>
                                <WrapPanel x:Name="RegionPanel"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Select exposure classes" Style="{StaticResource GhostButton}"
                                            Click="SelectExposure_Click"/>
                                    <Button Content="Clear all" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Click="ClearRegions_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="THRESHOLDS" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Face confidence (YuNet)" Style="{StaticResource SmallLabel}"/>
                                    <Slider x:Name="FaceConfidenceSlider" Minimum="0.05" Maximum="0.95" Value="0.6" ValueChanged="SettingChanged" Margin="0,0,0,14"/>
                                    <CheckBox x:Name="LocalFaceGuardCheck" Content="Expanded local guards for uncertain faces" Click="SettingChanged"/>
                                    <TextBlock Text="Candidates below face confidence receive larger opaque black masks. Disable for strict full-screen uncertainty cover. Capture/inference failures still cover the whole screen." Style="{StaticResource Muted}" Margin="0,4,0,14"/>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Anatomical confidence" Style="{StaticResource SmallLabel}"/>
                                            <Slider x:Name="ConfidenceSlider" Minimum="0.05" Maximum="0.95"
                                                    SmallChange="0.01" LargeChange="0.05" Value="0.35"
                                                    ValueChanged="SettingChanged"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource ValueBox}" VerticalAlignment="Bottom">
                                            <TextBlock x:Name="ConfidenceValue" Text="0.35" FontSize="12"/>
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="NMS IoU" Style="{StaticResource SmallLabel}"/>
                                            <Slider x:Name="NmsSlider" Minimum="0.1" Maximum="0.9"
                                                    SmallChange="0.01" LargeChange="0.05" Value="0.45"
                                                    ValueChanged="SettingChanged"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource ValueBox}" VerticalAlignment="Bottom">
                                            <TextBlock x:Name="NmsValue" Text="0.45" FontSize="12"/>
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Person detector confidence" Style="{StaticResource SmallLabel}"/>
                                            <Slider x:Name="PersonConfSlider" Minimum="0.05" Maximum="0.95"
                                                    SmallChange="0.01" LargeChange="0.05" Value="0.35"
                                                    ValueChanged="SettingChanged"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource ValueBox}" VerticalAlignment="Bottom">
                                            <TextBlock x:Name="PersonConfValue" Text="0.35" FontSize="12"/>
                                        </Border>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Whole-body confidence" Style="{StaticResource SmallLabel}"/>
                                            <Slider x:Name="WholeBodyConfSlider" Minimum="0.05" Maximum="0.95"
                                                    SmallChange="0.01" LargeChange="0.05" Value="0.5"
                                                    ValueChanged="SettingChanged"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource ValueBox}" VerticalAlignment="Bottom">
                                            <TextBlock x:Name="WholeBodyConfValue" Text="0.50" FontSize="12"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="WHOLE-PERSON MODE" Style="{StaticResource SectionTitle}"/>
                                    <CheckBox x:Name="WholeBodyCheck" Content="Censor whole tracked people"
                                              Click="SettingChanged"/>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,12"
                                               Text="Uses the person detector plus MediaPipe selfie segmentation. It is intentionally conservative and will treat an entire person as sensitive when evidence overlaps."/>
                                    <CheckBox x:Name="NudeOnlyCheck" Content="Only people with nearby exposed evidence"
                                              Click="SettingChanged" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox x:Name="WholeBodyFemaleCheck" Content="Female subjects" Click="SettingChanged"/>
                                        <CheckBox x:Name="WholeBodyMaleCheck" Content="Male subjects" Click="SettingChanged"
                                                  Margin="18,0,0,0"/>
                                    </StackPanel>
                                    <Border Style="{StaticResource Divider}"/>
                                    <TextBlock Text="DEBUG" Style="{StaticResource SectionTitle}"/>
                                    <CheckBox x:Name="DebugBoxesCheck" Content="Show tracked region boxes" Click="SettingChanged"/>
                                    <CheckBox x:Name="DebugLabelsCheck" Content="Show subject IDs and region labels"
                                              Click="SettingChanged" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="WHAT THE MODEL CAN AND CANNOT DO" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource Muted}"
                                           Text="NudeNet 320n predicts exposed and covered anatomy but has known gender/class confusion (for example, a male chest can be labelled as female breasts). YOLOv8n finds people, not nudity. MediaPipe produces a person silhouette, not clothing. The app never fabricates additional detector classes."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- CENSORING -->
                    <StackPanel x:Name="PageCensoring" Visibility="Collapsed">
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="STYLE" Style="{StaticResource SectionTitle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="StyleCombo" SelectionChanged="SettingChanged">
                                                <ComboBoxItem Content="Solid fill" Tag="Solid"/>
                                                <ComboBoxItem Content="Blur" Tag="Blur"/>
                                                <ComboBoxItem Content="Pixelate" Tag="Pixelate"/>
                                                <ComboBoxItem Content="Custom image" Tag="Image"/>
                                                <ComboBoxItem Content="Text label" Tag="Text"/>
                                                <ComboBoxItem Content="Outline + veil" Tag="Outline"/>
                                                <ComboBoxItem Content="Silhouette" Tag="Silhouette"/>
                                                <ComboBoxItem Content="Marker tape" Tag="Marker"/>
                                                <ComboBoxItem Content="Night vision" Tag="NightVision"/>
                                                <ComboBoxItem Content="Frosted glass" Tag="FrostedGlass"/>
                                            </ComboBox>
                                            <TextBlock Grid.Column="1" Text="Live" FontSize="11"
                                                       Foreground="{StaticResource GoodBrush}" VerticalAlignment="Center"
                                                       Margin="10,0,0,0"/>
                                        </Grid>

                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Opacity" Style="{StaticResource SmallLabel}"/>
                                                <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1"
                                                        SmallChange="0.01" Value="1" ValueChanged="SettingChanged"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource ValueBox}" VerticalAlignment="Bottom">
                                                <TextBlock x:Name="OpacityValue" Text="100%" FontSize="12"/>
                                            </Border>
                                        </Grid>
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Corner radius" Style="{StaticResource SmallLabel}"/>
                                                <Slider x:Name="CornerSlider" Minimum="0" Maximum="48"
                                                        SmallChange="1" Value="3" ValueChanged="SettingChanged"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource ValueBox}" VerticalAlignment="Bottom">
                                                <TextBlock x:Name="CornerValue" Text="3" FontSize="12"/>
                                            </Border>
                                        </Grid>

                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Fill colour" Style="{StaticResource SmallLabel}"/>
                                                <TextBox x:Name="ColorBox" Text="#0B0D12" TextChanged="SettingChanged"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Border colour" Style="{StaticResource SmallLabel}"/>
                                                <TextBox x:Name="BorderColorBox" Text="#FFFFFF" TextChanged="SettingChanged"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="STYLE PARAMETERS" Style="{StaticResource SectionTitle}"/>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Blur radius" Style="{StaticResource SmallLabel}"/>
                                                <Slider x:Name="BlurSlider" Minimum="0" Maximum="80"
                                                        SmallChange="1" Value="18" ValueChanged="SettingChanged"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource ValueBox}" VerticalAlignment="Bottom">
                                                <TextBlock x:Name="BlurValue" Text="18" FontSize="12"/>
                                            </Border>
                                        </Grid>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Pixel block" Style="{StaticResource SmallLabel}"/>
                                                <Slider x:Name="PixelSlider" Minimum="2" Maximum="96"
                                                        SmallChange="1" Value="14" ValueChanged="SettingChanged"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource ValueBox}" VerticalAlignment="Bottom">
                                                <TextBlock x:Name="PixelValue" Text="14" FontSize="12"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="Text label" Style="{StaticResource SmallLabel}"/>
                                        <TextBox x:Name="CustomTextBox" Text="HIDDEN" TextChanged="SettingChanged"/>
                                        <TextBlock Text="Image path" Style="{StaticResource SmallLabel}" Margin="0,12,0,5"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="ImagePathBox" Text="" TextChanged="SettingChanged"/>
                                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource GhostButton}"
                                                    Margin="8,0,0,0" Click="BrowseImage_Click"/>
                                        </Grid>
                                        <TextBlock Text="Corner radius is clamped geometrically. Outline and marker remain obscuring styles, not transparent annotations."
                                                   Style="{StaticResource Muted}" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="LIVE STYLE PREVIEW" Style="{StaticResource SectionTitle}"/>
                                        <Border Background="#0E1118" CornerRadius="10" ClipToBounds="True"
                                                Height="210" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <Grid x:Name="PreviewHost" ClipToBounds="True"/>
                                        </Border>
                                        <TextBlock Text="The preview uses a generated test image, not your desktop. The real overlay uses the same renderer with captured pixels."
                                                   Style="{StaticResource Muted}" Margin="0,9,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="TRACKING &amp; PREDICTION" Style="{StaticResource SectionTitle}"/>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Motion padding" Style="{StaticResource SmallLabel}"/>
                                                <Slider x:Name="MotionSlider" Minimum="0" Maximum="1"
                                                        SmallChange="0.01" Value="0.18" ValueChanged="SettingChanged"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource ValueBox}" VerticalAlignment="Bottom">
                                                <TextBlock x:Name="MotionValue" Text="18%" FontSize="12"/>
                                            </Border>
                                        </Grid>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Prediction horizon (ms)" Style="{StaticResource SmallLabel}"/>
                                                <Slider x:Name="HorizonSlider" Minimum="0" Maximum="300"
                                                        SmallChange="5" Value="80" ValueChanged="SettingChanged"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource ValueBox}" VerticalAlignment="Bottom">
                                                <TextBlock x:Name="HorizonValue" Text="80" FontSize="12"/>
                                            </Border>
                                        </Grid>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
